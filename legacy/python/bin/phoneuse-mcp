#!/bin/sh
# phoneuse MCP server (stdio). Needs the MCP SDK in .venv-mcp: scripts/setup-mcp.sh
# MCP clients may start servers with a minimal environment; phoneuse needs the
# desktop session's runtime directory (sockets) and Wayland display.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$WAYLAND_DISPLAY" ]; then
  WAYLAND_DISPLAY="$(cd "$XDG_RUNTIME_DIR" && ls wayland-* 2>/dev/null | grep -v lock | head -1)"
  export WAYLAND_DISPLAY
fi
cd "$ROOT" && exec "$ROOT/.venv-mcp/bin/python" -m phoneuse.mcp_server
